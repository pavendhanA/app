<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF7">

    <!-- Glow Background -->
    <View
        android:id="@+id/glowView"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_centerInParent="true"
        android:background="@drawable/bg_glow"
        android:alpha="0.0" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="140dp"
        android:alpha="0"
        android:scaleX="0.5"
        android:scaleY="0.5"
        android:src="@drawable/gateguard_logo" />

    <!-- App Name -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/imgLogo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:alpha="0"
        android:text="GATEGUARD"
        android:textColor="#0B2A4A"
        android:textSize="34sp"
        android:textStyle="bold" />

    <!-- Tagline -->
    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvAppName"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:alpha="0"
        android:text="SECURE ACCESS &amp; VISITOR MANAGEMENT"
        android:textColor="#0B2A4A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- ProgressBar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="180dp"
        android:layout_height="10dp"
        android:layout_below="@id/tvTagline"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#0E7FA3"
        android:alpha="0" />

    <!-- Loading Text -->
    <TextView
        android:id="@+id/tvLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/progressBar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="14dp"
        android:alpha="0"
        android:text="PREPARING ACCESS..."
        android:textColor="#0B2A4A"
        android:textSize="13sp" />

</RelativeLayout>