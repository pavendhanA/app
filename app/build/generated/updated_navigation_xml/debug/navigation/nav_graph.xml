<navigation
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/nav_graph"
app:startDestination="@id/splashFragment" >
<fragment
    android:id="@+id/splashFragment"
    android:name="com.gateguard.ui.splash.SplashFragment"
    tools:layout="@layout/fragment_splash" >

    <action
        android:id="@+id/action_splash_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

</fragment>
<fragment
    android:id="@+id/loginFragment"
    android:name="com.gateguard.ui.login.LoginFragment"
    tools:layout="@layout/fragment_login" >

    <action
        android:id="@+id/action_login_to_home"
        app:destination="@id/homeFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />
    <action
        android:id="@+id/action_login_to_register"
        app:destination="@id/registerFragment" />

</fragment>
<fragment
    android:id="@+id/registerFragment"
    android:name="com.gateguard.ui.login.RegisterFragment"
    tools:layout="@layout/fragment_register" >

    <action
        android:id="@+id/action_register_to_home"
        app:destination="@id/homeFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

</fragment>
<fragment
    android:id="@+id/homeFragment"
    android:name="com.gateguard.ui.home.HomeFragment"
    tools:layout="@layout/fragment_home" >

    <action
        android:id="@+id/action_home_to_generateQR"
        app:destination="@id/generateQRFragment" />
    <action
        android:id="@+id/action_home_to_scanner"
        app:destination="@id/scannerFragment" />

</fragment>
<fragment
    android:id="@+id/logsFragment"
    android:name="com.gateguard.ui.logs.LogsFragment"
    tools:layout="@layout/fragment_logs" />
<fragment
    android:id="@+id/notificationsFragment"
    android:name="com.gateguard.ui.notifications.NotificationsFragment"
    tools:layout="@layout/fragment_notifications" />
<fragment
    android:id="@+id/profileFragment"
    android:name="com.gateguard.ui.profile.ProfileFragment"
    tools:layout="@layout/fragment_profile" >

    <action
        android:id="@+id/action_profile_to_settings"
        app:destination="@id/settingsFragment" />
    <action
        android:id="@+id/action_profile_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

</fragment>
<fragment
    android:id="@+id/generateQRFragment"
    android:name="com.gateguard.ui.qr.GenerateQRFragment"
    tools:layout="@layout/fragment_generate_qr" >

    <action
        android:id="@+id/action_generateQR_to_qrDisplay"
        app:destination="@id/qrDisplayFragment" />

</fragment>
<fragment
    android:id="@+id/qrDisplayFragment"
    android:name="com.gateguard.ui.qr.QRDisplayFragment"
    tools:layout="@layout/fragment_qr_display" >

    <argument
        android:name="visitorData"
        app:argType="string" />

</fragment>
<fragment
    android:id="@+id/scannerFragment"
    android:name="com.gateguard.ui.scanner.ScannerFragment"
    tools:layout="@layout/fragment_scanner" >

    <action
        android:id="@+id/action_scanner_to_scanResult"
        app:destination="@id/scanResultFragment"
        app:popUpTo="@id/homeFragment" />

</fragment>
<fragment
    android:id="@+id/scanResultFragment"
    android:name="com.gateguard.ui.scanner.ScanResultFragment"
    tools:layout="@layout/fragment_scan_result" >

    <argument
        android:name="scanData"
        app:argType="string" />

</fragment>
<fragment
    android:id="@+id/settingsFragment"
    android:name="com.gateguard.ui.settings.SettingsFragment"
    tools:layout="@layout/fragment_settings" />
</navigation>